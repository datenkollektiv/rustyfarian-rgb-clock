# .env is OPTIONAL. No credentials are baked into the firmware image.
#
# Wi-Fi and MQTT settings are provisioned at runtime via the SoftAP captive
# portal and stored in NVS. See docs/features/wifi-softap-provisioning-v1.md.
#
# First boot (or after `just erase-flash`): the clock ring pulses amber and the
# device hosts an open "Rustyfarian-XXXX" access point. Connect to it, open the
# captive portal, and submit your Wi-Fi + MQTT details; the device restarts into
# the clock.
#
# The values below are NON-SECRET convenience defaults only: they pre-fill the
# portal form on a fresh / factory-reset device so you review values instead of
# retyping them. They are NOT used as connection credentials — only what you
# submit in the portal is. Passwords are NEVER set here and never pre-filled.
# Copy this file to `.env` and set any you like; unset ones use the fallbacks.
#
# WIFI_SSID=                  # default: "" (typed in the portal)
# MQTT_HOST=                  # default: "" (typed in the portal)
# MQTT_PORT=1883              # default: 1883, but only prefills alongside a set MQTT_HOST
# MQTT_USER=                  # default: "" (anonymous broker)
# MQTT_CLIENT_ID=rgb-clock    # default: rgb-clock
# OTA_HOST=                   # default: auto-detected LAN IP of this machine; used by just ota-artifact
# OTA_PORT=8000               # default: 8000; used by just ota-serve
# OTA_VARIANT=release         # just ota-artifact: release | unhealthy (demo image)
# OTA_VERSION=                # just ota-artifact: bake and advertise this version (demo)
# OTA_TRUNCATE=0              # just ota-artifact: serve only the first N bytes (demo)
# OTA_TICK_TOPIC=             # just ota-artifact: subscribe the image to this topic instead of "tick", staged under <variant>-topic-<name> (demo; unique per device and run; do not leave set)
